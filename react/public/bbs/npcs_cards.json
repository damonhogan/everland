      "Recover lost lore of the black sun and moon crystals",
      "Protect refugees"
    ],
    "secrets": [
      "The headpiece contains concentrated ambient magic he cannot fully control"
    ],
    "voice_lines": [
      "Stand fast — memory returns with action.",
      "We must bind the crystal before it consumes us."
    ],
    "costume": "Ritual robes with a small spider-themed headpiece; pouch with crystal globe prop.",
    "props": [
      "small globe (black crystal)",
      "tome or scroll"
    ],
    "friendly": true
  },
